# ─────────────────────────────────────────────────────────────────────────────
#  Environment variables — copy to .env and fill in.
#  .env is gitignored; this template is not.
# ─────────────────────────────────────────────────────────────────────────────

# Database — Neon serverless Postgres.
DATABASE_URL=

# Pusher — realtime (new messages, reactions, read receipts, typing).
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Cloudflare R2 — file uploads (images, video, documents).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN_URL=

# Upstash Redis — presence and the session-activity throttle.
# Presence uses a sorted-set index; the previous KEYS scan was O(keyspace).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push (VAPID) — browsers only. A native app cannot use this; it uses
# Firebase Cloud Messaging below. Both transports are stored side by side in
# PushSubscription.type and routed per row.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Firebase Cloud Messaging — native Android push (HTTP v1).
# Create a service account in Firebase Console → Project settings →
# Service accounts, then paste the downloaded JSON below.
# Without these, FCM is skipped and the app falls back to Web Push.
# See docs/native-app.md.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_JSON={}

# Discord webhook — optional; notification channel for new messages.
DISCORD_WEBHOOK_URL=

# Public origin, used to build absolute URLs and to decide whether an
# attachment URL is already first-party (avoids proxying R2 twice).
NEXT_PUBLIC_APP_URL=https://komunikasi.qzz.io
